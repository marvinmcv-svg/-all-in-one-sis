# ── DATABASE ──────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/clearpath?sslmode=require
DATABASE_URL_POOLER=postgresql://user:pass@host/clearpath?pgbouncer=true

# ── REDIS (Upstash) ───────────────────────────────────
# REST client — used by Next.js cache helpers and weekly-insight worker
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx
# ioredis TCP — used by BullMQ workers (get from Upstash console → "Connect" → ioredis)
UPSTASH_REDIS_HOST=xxx.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=xxxx

# ── AUTH (CLERK) ──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxx
CLERK_SECRET_KEY=sk_live_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxx

# ── AI ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx

# ── PAYMENTS (REVENUECAT) ─────────────────────────────
REVENUECAT_API_KEY=xxxx
REVENUECAT_WEBHOOK_SECRET=xxxx
# Mobile (exposed to app bundle — use the public SDK key, not secret key)
EXPO_PUBLIC_REVENUECAT_API_KEY=xxxx

# ── NOTIFICATIONS ─────────────────────────────────────
EXPO_ACCESS_TOKEN=xxxx

# ── EMAIL ─────────────────────────────────────────────
POSTMARK_API_TOKEN=xxxx
POSTMARK_FROM_EMAIL=hello@clearpath.app

# ── ANALYTICS ─────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_AUTH_TOKEN=xxxx

# ── APP ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://clearpath.app
API_GATEWAY_URL=https://api.clearpath.app
# In development, Next.js rewrites /api/v1/* to this URL
BACKEND_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=https://api.clearpath.app
NODE_ENV=development
PORT=3001
